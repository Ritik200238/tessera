# Tessera web — public config only (NEXT_PUBLIC_*). Safe to commit as a template.
# Copy to .env.local and adjust for your environment.
NEXT_PUBLIC_CHAIN_ENV=testnet
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_RPC_CHAIN_ID=421614
NEXT_PUBLIC_RPC_CHAIN_NAME=Arbitrum Sepolia
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
# Optional: the multisig/admin address gates the Admin nav item.
NEXT_PUBLIC_OWNER_ADDRESS=
NEXT_PUBLIC_ADMIN_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Canonical site URL (used for Open Graph / Twitter card + metadataBase).
# On Vercel set this to your deployment URL, e.g. https://tessera.vercel.app
NEXT_PUBLIC_SITE_URL=
# Privacy-first analytics (Plausible/Umami-compatible). Leave blank to disable.
# Set to your domain to enable the landing->connect->first-action->protection funnel.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Optional: your own RPC is tried first (keeps your traffic private). Public
# fallbacks are used behind it so no single provider sees every user.
# NEXT_PUBLIC_RPC_URL=
